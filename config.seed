CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt76x8=y
CONFIG_TARGET_ramips_mt76x8_DEVICE_tplink_tl-wr840n-v4=y

# do not build the extra initramfs image (saves ~6 MB of artifacts and build time)
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set

# USB host (MT7628: EHCI + OHCI), UVC webcams, MJPEG streamer
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-video-core=y
CONFIG_PACKAGE_kmod-video-uvc=y
CONFIG_PACKAGE_mjpg-streamer=y
CONFIG_PACKAGE_mjpg-streamer-input-uvc=y
CONFIG_PACKAGE_mjpg-streamer-output-http=y
CONFIG_PACKAGE_mjpg-streamer-output-file=y
CONFIG_PACKAGE_ustreamer=y

# per-stream byte counters for the traffic page (normally already pulled in by firewall4)
CONFIG_PACKAGE_nftables-json=y

# v4l2-ctl and libraries
CONFIG_PACKAGE_v4l-utils=y
CONFIG_PACKAGE_libv4l=y
CONFIG_PACKAGE_libstdcpp=y

# LuCI with Ukrainian
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_uk=y
CONFIG_PACKAGE_luci-i18n-base-uk=y

# not needed: PPP/PPPoE (WAN over DHCP / Wi-Fi client), USB storage, usbutils (busybox has lsusb)
# CONFIG_PACKAGE_ppp is not set
# CONFIG_PACKAGE_ppp-mod-pppoe is not set
# CONFIG_PACKAGE_kmod-usb-storage is not set
# CONFIG_PACKAGE_usbutils is not set
