#!/bin/sh /etc/rc.common
# UVC webcams -> MJPEG over HTTP (ustreamer or mjpg-streamer per camera).
# Settings: /etc/config/cams (LuCI: Services -> Webcams; traffic info: Services -> Webcams: traffic)
START=99
USE_PROCD=1
HASHF=/tmp/cams.streamhash
LISTF=/tmp/cams.list

# hash of everything that needs a stream restart (not brightness etc.)
stream_hash() {
  /usr/sbin/cams-list | cut -d'|' -f1-7,15-23 | md5sum | cut -d' ' -f1
}

service_triggers() {
  procd_add_reload_trigger cams
}

boot() {
  (
    cut -d. -f1 /proc/uptime > /tmp/cams.lock
    n=0
    while [ "$n" -lt 40 ] && ! ls /sys/class/video4linux/video* >/dev/null 2>&1; do
      sleep 1; n=$((n + 1))
    done
    sleep 3
    try=0
    while [ "$try" -lt 4 ]; do
      /etc/init.d/cams stop >/dev/null 2>&1
      killall mjpg_streamer ustreamer >/dev/null 2>&1
      sleep 2
      [ "$try" -ge 2 ] && /usr/sbin/cams-usbreset
      /etc/init.d/cams start
      sleep 12
      /usr/sbin/cams-check && break
      logger -t cams "start attempt $try failed, retrying"
      try=$((try + 1))
    done
    rm -f /tmp/cams.lock
  ) &
}

start_service() {
  /usr/sbin/cams-sync
  /usr/sbin/cams-list > "$LISTF"
  while IFS='|' read -r dev sec port user pass res fps br co sa ga sp pl name rot eng q nd sl xe drop buf wk note; do
    [ -n "$note" ] && logger -t cams "$name: $note (engine=$eng)"
    procd_open_instance "cam$port"
    if [ "$eng" = "ustreamer" ]; then
      procd_set_param command /usr/bin/ustreamer \
        --device "$dev" --format YUYV --resolution "$res" --desired-fps "$fps" \
        --encoder CPU --quality "$q" \
        --host 0.0.0.0 --port "$port" \
        --device-timeout 3 --device-error-delay 1 --no-log-colors
      [ "$nd" = 1 ] && procd_append_param command --tcp-nodelay
      [ "$sl" = 1 ] && procd_append_param command --slowdown
      [ "$xe" = 1 ] && procd_append_param command --exit-on-device-error
      [ -n "$drop" ] && procd_append_param command --drop-same-frames "$drop"
      [ -n "$buf" ] && procd_append_param command --buffers "$buf"
      [ -n "$wk" ] && procd_append_param command --workers "$wk"
      [ -n "$user" ] && procd_append_param command --user "$user" --passwd "$pass"
      procd_set_param stderr 1
      procd_set_param stdout 1
    else
      extra=""
      [ "$rot" = "180" ] && extra=" -swrot180"
      out="output_http.so -p $port"
      [ -n "$user" ] && out="$out -c $user:$pass"
      procd_set_param command /usr/bin/mjpg_streamer \
        -i "input_uvc.so -d $dev -r $res -f $fps -y -n$extra" \
        -o "$out"
    fi
    procd_set_param respawn 3600 5 0
    procd_close_instance
  done < "$LISTF"
  stream_hash > "$HASHF"
  /usr/sbin/cams-stats sync
  ( sleep 8; /usr/sbin/cams-apply ) &
}

stop_service() {
  /usr/sbin/cams-stats teardown
}

reload_service() {
  /usr/sbin/cams-sync
  if [ "$(stream_hash)" = "$(cat "$HASHF" 2>/dev/null)" ]; then
    /usr/sbin/cams-stats sync
    /usr/sbin/cams-apply &
  else
    stop
    start
  fi
}
